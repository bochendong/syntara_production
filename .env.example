# =============================================================================
# Syntara Environment Variables
# Copy this file to .env.local and fill in the values you need.
# All variables are optional — only configure the providers you want to use.
# You can also use server-providers.yml for configuration (see docs).
# =============================================================================

# --- Database & Auth (server persistent mode) --------------------------------

# 本地 PostgreSQL 连接串，例如：
# postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=
# 默认只读快速 CourseSource 目录；仅在排查未迁移的旧上传记录时临时设为 dual。
COURSE_SOURCE_CATALOG_READ_MODE=catalog
# 非本地数据库执行课程资料回填/重建时，必须显式确认：
# ALLOW_REMOTE_COURSE_KNOWLEDGE_MIGRATION=1
# 将单节课/笔记本从本地注入线上时使用的目标 PostgreSQL 连接串。
# scripts/maintenance/push-lesson-to-online-db.mjs 只会写这个目标库，不会把 DATABASE_URL 当作线上库。
ONLINE_DATABASE_URL=
# NextAuth：与浏览器访问地址一致，开发示例 http://localhost:3000
NEXTAUTH_URL=
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET=

# Speedup AI course SSO（仅服务端使用，ClientSecret 不得放入 NEXT_PUBLIC_* 变量）
# TeacherCourses / StudentCourses 需返回当学期课程，并用 UniversityAbbrs（如 UTSG）区分校区。
SPEEDUP_API_BASE_URL=
SPEEDUP_SSO_CLIENT_ID=
SPEEDUP_SSO_CLIENT_SECRET=
# 仅供不连接持久数据库的隔离联调环境使用；正式环境保持为 0。
SPEEDUP_SSO_ALLOW_STATELESS=0
# 首发阶段只开放老师端、管理员端和教师课程聊天。
TEACHER_ONLY_LAUNCH=true

# 临时管理员登录（独立于老师账号）。
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
ADMIN_LOGIN_SECRET=
ADMIN_EMAILS=

# 用于加密 PostgreSQL 中的全站 API Key；生产环境必须单独配置并长期保留。
SYSTEM_CONFIG_ENCRYPTION_KEY=

# --- Public API v1 -----------------------------------------------------------
# External callers use: Authorization: Bearer <token>
# Single-key setup (good for local development or one integration partner):
SYNTARA_PUBLIC_API_KEY=
SYNTARA_PUBLIC_API_USER_ID=
SYNTARA_PUBLIC_API_KEY_ID=default
# Multi-key setup. JSON array; keep it on one line in .env.local.
# SYNTARA_PUBLIC_API_KEYS=[{"token":"sk_syntara_replace_me","userId":"user_cuid","keyId":"partner-a"}]

# --- Native App platform AI --------------------------------------------------
# Native App defaults to a database-backed device login. Only authenticated
# users may call the platform AI; provider credentials stay on this server.
SYNTARA_NATIVE_API_AUTH_MODE=authenticated
# Optional separate HMAC secret for Native device tokens. If omitted,
# NEXTAUTH_SECRET is used. Production secrets should be at least 32 characters.
SYNTARA_NATIVE_AUTH_SECRET=
# Fake email login is disabled by default. Set to 1 only for an isolated demo.
SYNTARA_ALLOW_DEMO_AUTH=0
# Build-time Native gateway origin. It must be HTTPS and contain no path.
SYNTARA_NATIVE_API_BASE_URL=https://www.chatai.ca
# Testing phase default: authenticated users share the platform AI credentials
# and are not blocked by legacy compute-credit balances. Set this to true only
# when real compute-credit billing is ready to launch.
SYNTARA_ENABLE_COMPUTE_CREDIT_SPENDING=false

# OAuth（登录页「使用 Google / GitHub 登录」；至少配置一组）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Payments (Stripe) ------------------------------------------------------
# Get these from the Stripe Dashboard.
# Webhook endpoint example: https://your-domain.com/api/top-up/webhooks/stripe

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- LLM Providers -----------------------------------------------------------
# Format: {PROVIDER}_API_KEY, {PROVIDER}_BASE_URL (optional), {PROVIDER}_MODELS (optional, comma-separated)

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODELS=

GOOGLE_API_KEY=
GOOGLE_BASE_URL=
GOOGLE_MODELS=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODELS=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODELS=

KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODELS=

MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODELS=

GLM_API_KEY=
GLM_BASE_URL=
GLM_MODELS=

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODELS=

DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODELS=

GROK_API_KEY=
GROK_BASE_URL=
GROK_MODELS=

# --- TTS (Text-to-Speech) ----------------------------------------------------

TTS_OPENAI_API_KEY=
TTS_OPENAI_BASE_URL=

TTS_AZURE_API_KEY=
TTS_AZURE_BASE_URL=

TTS_GLM_API_KEY=
TTS_GLM_BASE_URL=

TTS_QWEN_API_KEY=
TTS_QWEN_BASE_URL=

TTS_ELEVENLABS_API_KEY=
TTS_ELEVENLABS_BASE_URL=

# --- ASR (Automatic Speech Recognition) --------------------------------------

ASR_OPENAI_API_KEY=
ASR_OPENAI_BASE_URL=

ASR_QWEN_API_KEY=
ASR_QWEN_BASE_URL=

# --- PDF Processing -----------------------------------------------------------

PDF_UNPDF_API_KEY=
PDF_UNPDF_BASE_URL=

PDF_MINERU_API_KEY=
PDF_MINERU_BASE_URL=

# --- Image Generation ---------------------------------------------------------

IMAGE_SEEDREAM_API_KEY=
IMAGE_SEEDREAM_BASE_URL=

IMAGE_QWEN_IMAGE_API_KEY=
IMAGE_QWEN_IMAGE_BASE_URL=

IMAGE_NANO_BANANA_API_KEY=
IMAGE_NANO_BANANA_BASE_URL=

IMAGE_GROK_API_KEY=
IMAGE_GROK_BASE_URL=

# OpenAI Images（默认 gpt-image-2）；可与上方 LLM 的 OPENAI_API_KEY 使用同一密钥
IMAGE_OPENAI_IMAGE_API_KEY=
IMAGE_OPENAI_IMAGE_BASE_URL=
IMAGE_OPENAI_IMAGE_MODELS=gpt-image-2,gpt-image-1.5,gpt-image-1

# --- Video Generation ---------------------------------------------------------

VIDEO_SEEDANCE_API_KEY=
VIDEO_SEEDANCE_BASE_URL=

VIDEO_KLING_API_KEY=
VIDEO_KLING_BASE_URL=

VIDEO_VEO_API_KEY=
VIDEO_VEO_BASE_URL=

VIDEO_SORA_API_KEY=
VIDEO_SORA_BASE_URL=

VIDEO_GROK_API_KEY=
VIDEO_GROK_BASE_URL=

# --- Web Search ---------------------------------------------------------------
# Note: Grok (xAI) web search is available via chat completions + search tools,
# not as a standalone search API. Use Grok LLM provider with search_parameters
# in chat requests. See: https://docs.x.ai/docs/guides/tools/search-tools

TAVILY_API_KEY=

# --- Proxy (optional) --------------------------------------------------------

# HTTP_PROXY=
# HTTPS_PROXY=

# --- App shell (optional) -----------------------------------------------------
# 左侧栏「联系客服」「报告问题」链接；不填则使用仓库内默认讨论区 / 新建 Issue
# NEXT_PUBLIC_CONTACT_SUPPORT_URL=https://example.com/help
# NEXT_PUBLIC_REPORT_ISSUE_URL=https://example.com/feedback

# --- Misc ---------------------------------------------------------------------

# Optional server-side default model for API routes like /api/generate-classroom
# 老师与学生的日常语言模型默认使用 GPT-5.6 Luna；笔记本整理默认使用 GPT-5.6 Terra。
# OpenAI 的系统级配置请填裸模型 ID；其他 provider 可继续使用 provider:model。
DEFAULT_MODEL=gpt-5.6-luna
# Optional embedding model for database-backed study-memory vector recall.
# Defaults to text-embedding-3-small and stores 1536-dimensional pgvector rows.
STUDY_MEMORY_EMBEDDING_MODEL=

# LOG_LEVEL=info
# LOG_FORMAT=pretty
# LLM_THINKING_DISABLED=false
