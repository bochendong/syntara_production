{
  "name": "@syntara/native",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "dotenv -e ../../.env.local -- tauri dev",
    "desktop:build": "dotenv -e ../../.env.local -- tauri build --bundles app",
    "ios:init": "dotenv -e ../../.env.local -- sh -c 'PATH=./scripts:$PATH tauri ios init \"$@\"' --",
    "ios:dev": "dotenv -e ../../.env.local -- sh -c 'PATH=./scripts:$PATH tauri ios dev \"$@\"' --",
    "ios:build": "dotenv -e ../../.env.local -- sh -c 'PATH=./scripts:$PATH tauri ios build \"$@\"' --",
    "android:init": "dotenv -e ../../.env.local -- tauri android init",
    "android:dev": "dotenv -e ../../.env.local -- tauri android dev",
    "android:build": "dotenv -e ../../.env.local -- tauri android build --apk",
    "desktop:build:staging": "node scripts/build-channel.mjs staging",
    "ios:build:staging": "node scripts/build-channel.mjs staging ios"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "dexie": "^4.2.1",
    "katex": "^0.16.38",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
