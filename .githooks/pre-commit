#!/bin/sh
# syntara-worktree-guard-v1
# This hook is installed locally by pnpm workspace:guard.
set -eu

if [ "${SYNTARA_ALLOW_SHARED_COMMIT:-}" = "1" ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
branch=$(git symbolic-ref --quiet --short HEAD || true)
shared=$(git config --local --get syntara.sharedWorktree || true)

case "$branch" in
  main|master|codex/shared-wip-*|'') blocked=1 ;;
  *) blocked=0 ;;
esac

if [ "$root" = "$shared" ]; then
  blocked=1
fi

if [ "$blocked" = "1" ]; then
  printf '%s\n' \
    'Syntara: commits from main, detached HEAD, or the legacy shared checkout are blocked.' \
    'Use a separate worktree on a task branch and stage only that task’s changes.' \
    'An explicitly authorized integration may use SYNTARA_ALLOW_SHARED_COMMIT=1.' >&2
  exit 1
fi
