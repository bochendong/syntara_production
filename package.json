  "scripts": {
    "postinstall": "cd packages/mathml2omml && npm run build && cd ../pptxgenjs && npm run build",
    "dev": "next dev --turbo",
    "build": "node scripts/deploy/run-vercel-migrations.mjs && prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:changed": "node scripts/maintenance/check-changed-lint.mjs",
    "check": "prettier . --check",
    "check:changed": "node scripts/maintenance/check-changed-format.mjs",
    "format": "prettier . --write",
    "repo:audit": "node scripts/maintenance/audit-repository-structure.mjs",
    "notebooks:inline-generated-images": "dotenv -e .env.local -- node scripts/maintenance/inline-generated-notebook-page-images.mjs",
    "notebooks:import-generated-assets": "node scripts/maintenance/import-generated-notebook-assets-to-db.mjs",
    "notebooks:push-lesson": "node scripts/maintenance/push-lesson-to-online-db.mjs",
    "notebooks:repair-focus": "dotenv -e .env.local -- node scripts/maintenance/repair-image-notebook-focus-elements.mjs",
    "notebooks:import-cpsc107-markdown": "node scripts/maintenance/import-cpsc107-queue-markdown-notebooks.mjs",
    "notebooks:rebuild-queue": "node scripts/maintenance/rebuild-queue-notebooks.mjs",
    "memory:inject-course": "node scripts/maintenance/inject-course-public-memory.mjs",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:verify:course-notebook-counts": "dotenv -e .env.local -- sh -c 'PGCONNECT_TIMEOUT=10 PGOPTIONS=\"-c statement_timeout=30000 -c lock_timeout=5000\" psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -P pager=off -f scripts/maintenance/verify-course-notebook-counts.sql'",
    "db:v2:export-critical": "dotenv -e .env.local -- node scripts/maintenance/export-db-v2-critical-data.mjs",
    "native:archive:export": "dotenv -e .env.local -- node scripts/maintenance/export-native-archive.mjs",
    "native:benchmark": "node scripts/maintenance/benchmark-native-local-data.mjs",
    "native:mock-lectures:generate": "dotenv -e .env.local -- node scripts/notebooks/generate-native-mat136-mini-lectures.mjs",
    "native:snapshot:export": "dotenv -e .env.local -- node scripts/maintenance/export-native-problem-snapshot.mjs",
    "native:ui-parity": "node scripts/maintenance/verify-web-native-ui-parity.mjs",
    "native:verify": "node --experimental-strip-types scripts/maintenance/verify-native-local-data.mjs",
    "native:verify:platform-access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/maintenance/verify-native-platform-access.mjs",
    "db:v2:backfill": "dotenv -e .env.local -- node scripts/maintenance/backfill-db-v2-summaries.mjs",
    "db:course-knowledge:backfill": "node scripts/maintenance/backfill-course-source-knowledge.mjs",
    "db:course-knowledge:reindex": "node scripts/maintenance/reindex-course-knowledge-chunks.mjs",
    "db:course-rules:rebuild": "dotenv -e .env.local -- node scripts/maintenance/rebuild-course-rule-packs.mjs",
    "credits:backfill-500": "dotenv -e .env.local -- node scripts/maintenance/backfill-credits-to-500.mjs",
    "backend:up": "bash scripts/maintenance/start-backend.sh",
    "backend:dev": "bash scripts/maintenance/start-backend.sh --dev",
    "frontend:dev": "bash scripts/maintenance/start-frontend.sh",
    "frontend:dev:clean": "bash scripts/maintenance/start-frontend.sh --clean",
    "test:course-chat": "node scripts/maintenance/test-course-chat-services.mjs",
    "test:course-knowledge-contracts": "node scripts/maintenance/verify-course-source-knowledge-contracts.mjs",
    "test:course-answer-contracts": "node scripts/maintenance/verify-course-answer-contracts.mjs",
    "test:course-notebook-count-contracts": "node scripts/maintenance/verify-course-notebook-count-contracts.mjs",
    "test:ai-data-budgets": "node scripts/maintenance/verify-ai-answer-data-budgets.mjs",
    "test:source-upload-data-budgets": "node scripts/maintenance/verify-source-upload-ingestion-data-budgets.mjs",
    "test:markdown-section-progressive-api": "node scripts/maintenance/verify-markdown-section-progressive-api-contracts.mjs",
    "test:notebook-popup-progressive-cutover": "node scripts/maintenance/verify-notebook-popup-progressive-cutover.mjs",
    "test:web-learning-progress": "node scripts/maintenance/verify-web-learning-progress-contracts.mjs",
    "test:learn-mini-lecture": "node scripts/maintenance/verify-learn-mini-lecture-contracts.mjs",
    "test:memory-write-latency": "node scripts/maintenance/verify-memory-write-latency-contracts.mjs",
    "test:calendar-server-contracts": "node scripts/maintenance/verify-learning-calendar-server-contracts.mjs",
    "test:course-lesson-plan": "node scripts/maintenance/verify-course-lesson-ingest-planner-contracts.mjs",
    "test:source-ingest-docx": "node scripts/maintenance/verify-source-ingest-docx-contracts.mjs",
    "test:openai-file-upload-contracts": "node scripts/maintenance/verify-openai-file-upload-contracts.mjs",
    "test:problem-auto-archive-contracts": "node scripts/maintenance/verify-problem-auto-archive-contracts.mjs",
    "test:course-space-problem-bank-ui-contracts": "node scripts/maintenance/verify-course-space-problem-bank-ui-contracts.mjs",
    "test:course-forum-selection-contracts": "node scripts/maintenance/verify-course-forum-selection-contracts.mjs",
    "test:course-forum-attachment-contracts": "node scripts/maintenance/verify-course-forum-attachment-contracts.mjs",
    "test:course-forum-moderation-contracts": "node scripts/maintenance/verify-course-forum-moderation-contracts.mjs",
    "test:problem-import-idempotency": "node scripts/maintenance/verify-problem-import-commit-idempotency.mjs",
    "test:learn-core-contracts": "node scripts/learn/run-learn-core-contract-checks.mjs",
    "test:learn-core-compat": "node scripts/learn/run-learn-core-compat-checks.mjs",
    "test:learn-scenarios": "node scripts/learn/run-learn-scenarios.mjs",
    "test:learn-initial-cases": "node scripts/learn/run-learn-initial-cases.mjs",
    "test:image-gen": "dotenv -e .env.local -- node scripts/smoke/test-openai-image.mjs",
    "test:tts-gen": "dotenv -e .env.local -- node scripts/smoke/test-openai-tts.mjs"
  },
