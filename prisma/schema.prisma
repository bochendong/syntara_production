generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CoursePurpose {
  research
  university
  daily
}

enum CourseAcademicTerm {
  winter
  summer
  fall
}

enum NotebookKind {
  image
  markdown
}

enum ConversationKind {
  notebook
  agent
  system
  course
}

enum CourseConversationMessageRole {
  user
  assistant
}

enum AgentTaskStatus {
  queued
  running
  waiting
  completed
  failed
  cancelled
}

enum AgentEnvelopeType {
  task_dispatch
  task_ack
  task_wait
  task_partial
  task_result
  task_error
}

enum UserRole {
  USER
  STUDENT
  TEACHER
  ADMIN
}

enum NativeDeviceAuthorizationStatus {
  pending
  approved
  consumed
  denied
}

enum CreditTransactionKind {
  WELCOME_BONUS
  COURSE_PURCHASE
  NOTEBOOK_PURCHASE
  CREATOR_COURSE_SALE
  CREATOR_NOTEBOOK_SALE
  TOKEN_USAGE
  CASH_TO_COMPUTE_TRANSFER
  CASH_TO_PURCHASE_TRANSFER
  LESSON_REWARD
  QUIZ_COMPLETION_REWARD
  QUIZ_ACCURACY_BONUS
  REVIEW_REWARD
  DAILY_TASK_REWARD
  STREAK_BONUS
  CHARACTER_UNLOCK_SPEND
  AVATAR_UNLOCK_SPEND
  GACHA_DRAW_SPEND
  /// @deprecated Kept for backward compatibility — existing rows in the database still reference this value
  NOTEBOOK_GENERATION_USAGE
}

enum CreditAccountType {
  CASH
  COMPUTE
  PURCHASE
  /// @deprecated Kept for backward compatibility — existing rows in the database still reference this value
  NOTEBOOK_GENERATION
}

enum TopUpOrderStatus {
  pending
  fulfilled
  expired
}

enum CharacterAssetType {
  LIVE2D
  AVATAR
}

enum LearningActionType {
  DAILY_SIGN_IN
  LESSON_MILESTONE_COMPLETED
  QUIZ_COMPLETED
  QUIZ_ACCURACY_BONUS
  REVIEW_COMPLETED
  DAILY_TASK_REWARD
  STREAK_BONUS
  CHARACTER_UNLOCK
  AVATAR_UNLOCK
  CHARACTER_EQUIP
  GACHA_DRAW
}

enum MissionType {
  DAILY_SIGN_IN
  DAILY_LESSON
  DAILY_QUIZ
  DAILY_REVIEW
  DAILY_ALL_CLEAR
  WEEKLY_STUDY_DAYS
  WEEKLY_QUIZ_BATCHES
}

enum NotebookProblemType {
  short_answer
  choice
  proof
  calculation
  code
  fill_blank
}

enum NotebookProblemStatus {
  draft
  published
  archived
}

enum NotebookProblemSource {
  chat
  pdf
  manual
  web
  legacy_quiz_scene
}

enum NotebookProblemDifficulty {
  easy
  medium
  hard
}

enum NotebookProblemAttemptKind {
  run
  submit
  answer
}

enum NotebookProblemAttemptStatus {
  pending
  passed
  failed
  partial
  error
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String?   @unique
  emailVerified          DateTime?
  image                  String?
  role                   UserRole  @default(USER)
  isActive               Boolean   @default(true)
  passwordHash           String?
  creditsBalance         Int       @default(0)
  computeCreditsBalance  Int       @default(0)
  purchaseCreditsBalance Int       @default(0)
  stripeCustomerId       String?   @unique

  accounts                   Account[]
  sessions                   Session[]
  nativeDeviceAuthorizations NativeDeviceAuthorization[]
  nativeDeviceSessions       NativeDeviceSession[]

  courses                 Course[]
  notebooks               Notebook[]
  conversations           Conversation[]
  messages                Message[]
  courseConversations     CourseConversation[]
  agentTasks              AgentTask[]
  agentEnvelopes          AgentEnvelope[]
  llmUsageLogs            LLMUsageLog[]
  llmPromptLogs           LLMPromptLog[]
  creditTransactions      CreditTransaction[]
  cloudUsageLimit         CloudUsageUserLimit?
  cloudUsageCostLogs      CloudUsageCostLog[]
  coursePurchases         CoursePurchase[]
  courseEnrollments       CourseEnrollment[]
  courseHardRules         CourseHardRule[]
  notebookPurchases       NotebookPurchase[]
  courseReviews           CourseReview[]
  notebookReviews         NotebookReview[]
  notebookProblemAttempts NotebookProblemAttempt[]
  notebookProblemProgress NotebookProblemProgress[]
  topUpOrders             TopUpOrder[]
  engagementProfile       UserEngagementProfile?
  learningActionLogs      LearningActionLog[]
  characterProgress       UserCharacterProgress[]
  missionProgress         UserMissionProgress[]
  testResults             TestResult[]
  studyMemories           StudyMemory[]
  studyMemoryChunks       StudyMemoryChunk[]
  memoryFacts             MemoryFact[]
  memoryFactEvents        MemoryFactEvent[]
  knowledgeCacheEntries   MemoryKnowledgeCache[]
  courseSources           CourseSource[]
  knowledgeDocuments      KnowledgeDocument[]
  knowledgeChunks         KnowledgeChunk[]
  speechAudios            UserSpeechAudio[]
  problemImportBatches    ProblemImportBatch[]
  courseQuestionRuns      CourseQuestionRun[]
  learningCalendarEvents  LearningCalendarEvent[]
  calendarMutations       LearningCalendarMutation[]
  forumPosts              CourseForumPost[]          @relation("CourseForumPostAuthor")
  forumAnswers            CourseForumAnswer[]        @relation("CourseForumAnswerAuthor")
  acceptedForumAnswers    CourseForumAnswer[]        @relation("CourseForumAnswerAcceptedBy")
  forumComments           CourseForumComment[]       @relation("CourseForumCommentAuthor")
  forumAttachments        CourseForumAttachment[]    @relation("CourseForumAttachmentUploader")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive, updatedAt(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NativeDeviceAuthorization {
  id                     String                          @id @default(cuid())
  deviceCodeHash         String                          @unique
  userCodeHash           String                          @unique
  requestFingerprintHash String
  deviceId               String
  deviceName             String
  status                 NativeDeviceAuthorizationStatus @default(pending)
  userId                 String?
  expiresAt              DateTime
  approvedAt             DateTime?
  consumedAt             DateTime?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestFingerprintHash, createdAt])
  @@index([deviceId, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model NativeDeviceSession {
  id               String    @id @default(cuid())
  userId           String
  deviceId         String
  deviceName       String
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, refreshExpiresAt])
  @@index([deviceId, revokedAt])
}

model Course {
  id                    String              @id @default(cuid())
  ownerId               String
  name                  String
  description           String?
  language              String              @default("zh-CN")
  tags                  String[]
  purpose               CoursePurpose       @default(daily)
  university            String?
  courseCode            String?
  academicYear          Int?
  academicTerm          CourseAcademicTerm?
  avatarUrl             String?
  /**
   * 开启后出现在「课程商城」社区列表
   */
  listedInCourseStore   Boolean             @default(false)
  coursePriceCents      Int                 @default(0)
  storePublishedAt      DateTime?
  sourceCourseId        String?
  notebookCount         Int                 @default(0)
  sceneCount            Int                 @default(0)
  problemCount          Int                 @default(0)
  publishedProblemCount Int                 @default(0)
  speechReadyCount      Int                 @default(0)
  speechTotalCount      Int                 @default(0)

  owner                  User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notebooks              Notebook[]
  notebookPages          NotebookPage[]
  markdownSections       MarkdownNotebookSection[]
  problems               NotebookProblem[]
  conversations          Conversation[]
  courseConversations    CourseConversation[]
  agentTasks             AgentTask[]
  sourcePurchases        CoursePurchase[]          @relation("CoursePurchaseSource")
  clonePurchase          CoursePurchase?           @relation("CoursePurchaseClone")
  enrollments            CourseEnrollment[]
  reviews                CourseReview[]
  studyMemories          StudyMemory[]
  studyMemoryChunks      StudyMemoryChunk[]
  knowledgeCache         MemoryKnowledgeCache[]
  problemImports         ProblemImportBatch[]
  questionRuns           CourseQuestionRun[]
  courseSources          CourseSource[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeChunks        KnowledgeChunk[]
  learningCalendarEvents LearningCalendarEvent[]
  hardRules              CourseHardRule[]
  forumPosts             CourseForumPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([ownerId, academicYear, academicTerm])
  @@index([listedInCourseStore, updatedAt(sort: Desc)])
}

model CourseHardRule {
  id       String @id @default(cuid())
  courseId String
  ownerId  String
  content  String @db.Text
  position Int    @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, position, createdAt])
  @@index([ownerId, updatedAt(sort: Desc)])
}

model Notebook {
  id                    String       @id @default(cuid())
  ownerId               String
  courseId              String?
  name                  String
  description           String?
  tags                  String[]
  avatarUrl             String?
  language              String?
  style                 String?
  notebookKind          NotebookKind @default(image)
  listedInNotebookStore Boolean      @default(false)
  notebookPriceCents    Int          @default(0)
  storePublishedAt      DateTime?
  sourceNotebookId      String?
  sceneCount            Int          @default(0)
  sectionCount          Int          @default(0)
  problemCount          Int          @default(0)
  publishedProblemCount Int          @default(0)
  speechReadyCount      Int          @default(0)
  speechTotalCount      Int          @default(0)
  speechStatus          String       @default("no_speech")
  coverSlideJson        Json?
  coverImagePath        String?
  mindMapData           Bytes?
  mindMapMime           String?
  removedAt             DateTime?
  contentVersion        Int          @default(1)

  owner              User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  course             Course?                   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  scenes             Scene[]
  markdownSections   MarkdownNotebookSection[]
  pages              NotebookPage[]
  problems           NotebookProblem[]
  conversations      Conversation[]
  agentTasks         AgentTask[]
  sourcePurchases    NotebookPurchase[]        @relation("NotebookPurchaseSource")
  clonePurchase      NotebookPurchase?         @relation("NotebookPurchaseClone")
  reviews            NotebookReview[]
  studyMemories      StudyMemory[]
  studyMemoryChunks  StudyMemoryChunk[]
  knowledgeCache     MemoryKnowledgeCache[]
  problemImports     ProblemImportBatch[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([courseId, updatedAt(sort: Desc)])
  @@index([courseId, removedAt, updatedAt(sort: Desc)])
  @@index([courseId, contentVersion])
  @@index([listedInNotebookStore, updatedAt(sort: Desc)])
}

model Scene {
  id         String @id @default(cuid())
  notebookId String
  title      String
  type       String
  order      Int
  content    Json
  actions    Json?
  whiteboard Json?

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notebookId, order])
}

model MarkdownNotebookSection {
  id         String  @id @default(cuid())
  notebookId String
  courseId   String?
  title      String
  order      Int
  markdown   String  @db.Text
  summary    String? @db.Text
  sourceMeta Json?

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  course   Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notebookId, order])
  @@index([courseId, order])
  @@index([notebookId, updatedAt(sort: Desc)])
}

model NotebookPage {
  id             String  @id @default(cuid())
  notebookId     String
  courseId       String?
  sourceSceneId  String?
  title          String
  type           String
  order          Int
  contentHash    String?
  actionsHash    String?
  thumbnailJson  Json?
  coverImagePath String?

  notebook Notebook             @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  course   Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  content  NotebookPageContent?
  actions  NotebookPageActions?
  assets   NotebookPageAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notebookId, order])
  @@index([courseId, order])
  @@index([sourceSceneId])
  @@index([notebookId, updatedAt(sort: Desc)])
}

model NotebookPageContent {
  pageId     String @id
  content    Json
  whiteboard Json?

  page NotebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotebookPageActions {
  pageId           String @id
  actions          Json?
  speechReadyCount Int    @default(0)
  speechTotalCount Int    @default(0)
  speechStatus     String @default("no_speech")

  page NotebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotebookImageAsset {
  id        String  @id @default(cuid())
  path      String  @unique
  mimeType  String
  data      Bytes
  sizeBytes Int
  sha256    String
  source    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sha256])
}

model Asset {
  id        String  @id @default(cuid())
  path      String  @unique
  mimeType  String
  sizeBytes Int
  sha256    String
  source    String?
  data      Bytes?

  pageLinks NotebookPageAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sha256])
  @@index([source])
}

model NotebookPageAsset {
  id       String @id @default(cuid())
  pageId   String
  assetId  String
  role     String @default("image")
  order    Int    @default(0)
  metaJson Json?

  page  NotebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  asset Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, assetId, role])
  @@index([assetId])
  @@index([pageId, order])
}

model NotebookProblem {
  id                String                    @id @default(cuid())
  courseId          String?
  notebookId        String?
  title             String
  type              NotebookProblemType
  status            NotebookProblemStatus     @default(draft)
  source            NotebookProblemSource     @default(manual)
  order             Int
  problemNumber     Int?
  points            Int                       @default(1)
  tags              String[]
  difficulty        NotebookProblemDifficulty @default(medium)
  publicContentJson Json
  gradingJson       Json
  sourceMeta        Json?
  dedupeKey         String?

  course   Course?                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notebook Notebook?                 @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  secret   NotebookProblemSecret?
  attempts NotebookProblemAttempt[]
  progress NotebookProblemProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, dedupeKey], map: "NotebookProblem_course_dedupe_key")
  @@index([courseId, order])
  @@index([courseId, problemNumber])
  @@index([courseId, status, order])
  @@index([courseId, updatedAt(sort: Desc)])
  @@index([notebookId, order])
  @@index([notebookId, problemNumber])
  @@index([notebookId, updatedAt(sort: Desc)])
}

model ProblemImportBatch {
  id                   String    @id @default(cuid())
  ownerId              String
  courseId             String?
  notebookId           String?
  targetType           String
  source               String
  status               String    @default("previewed")
  sourceFileName       String?
  sourceFileMime       String?
  sourceTextHash       String?
  draftCount           Int       @default(0)
  committedCount       Int       @default(0)
  commitPayloadHash    String?
  commitLeaseToken     String?
  commitLeaseExpiresAt DateTime?
  commitResultJson     Json?
  draftSnapshotJson    Json?
  usageJson            Json?
  webSearchJson        Json?
  warnings             String[]

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  notebook Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, targetType, courseId, updatedAt(sort: Desc)])
  @@index([ownerId, targetType, notebookId, updatedAt(sort: Desc)])
  @@index([ownerId, status, updatedAt(sort: Desc)])
}

model CourseQuestionRun {
  id                 String    @id
  ownerId            String
  courseId           String
  idempotencyKey     String
  requestHash        String
  requestId          String
  sessionId          String
  status             String    @default("processing")
  leaseToken         String?
  leaseExpiresAt     DateTime?
  question           String
  answer             String?
  responseJson       Json?
  conversationId     String?
  userMessageId      String?
  assistantMessageId String?
  model              String?
  errorReason        String?

  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  conversation CourseConversation? @relation(fields: [conversationId, ownerId, courseId, sessionId], references: [id, ownerId, courseId, sessionId], onDelete: NoAction, map: "CourseQuestionRun_conversation_scope_fkey")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@unique([ownerId, courseId, idempotencyKey])
  @@index([ownerId, courseId, updatedAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
  @@index([conversationId, ownerId, courseId, sessionId], map: "CourseQuestionRun_conversation_scope_idx")
}

model NotebookProblemSecret {
  problemId       String @id
  secretJudgeJson Json

  problem NotebookProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotebookProblemAttempt {
  id         String                       @id @default(cuid())
  problemId  String
  userId     String
  kind       NotebookProblemAttemptKind
  answerJson Json
  resultJson Json?
  score      Float?
  status     NotebookProblemAttemptStatus @default(pending)

  problem NotebookProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  latestProgress NotebookProblemProgress? @relation("LatestNotebookProblemAttempt")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([problemId, createdAt(sort: Desc)])
  @@index([problemId, userId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model NotebookProblemProgress {
  id              String                       @id @default(cuid())
  problemId       String
  userId          String
  latestAttemptId String?
  status          NotebookProblemAttemptStatus @default(pending)
  score           Float?
  attemptedCount  Int                          @default(0)
  passedCount     Int                          @default(0)
  lastAttemptAt   DateTime?

  problem       NotebookProblem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  latestAttempt NotebookProblemAttempt? @relation("LatestNotebookProblemAttempt", fields: [latestAttemptId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([problemId, userId])
  @@unique([latestAttemptId])
  @@index([userId, status, lastAttemptAt(sort: Desc)])
  @@index([problemId, status])
  @@index([userId, lastAttemptAt(sort: Desc)])
}

model Conversation {
  id         String           @id @default(cuid())
  ownerId    String
  courseId   String?
  notebookId String?
  kind       ConversationKind
  targetId   String?
  title      String?
  meta       Json?

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  notebook Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([courseId, updatedAt(sort: Desc)])
  @@index([notebookId, updatedAt(sort: Desc)])
}

model Message {
  id             String  @id @default(cuid())
  conversationId String
  ownerId        String
  role           String
  senderAgentId  String?
  targetAgentId  String?
  content        Json
  plainText      String?
  meta           Json?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([ownerId, createdAt(sort: Desc)])
}

model CourseConversation {
  id        String @id
  ownerId   String
  courseId  String
  sessionId String @db.VarChar(160)
  title     String @default("新对话") @db.VarChar(200)

  revision  BigInt    @default(0)
  deletedAt DateTime?

  lastMessageAt          DateTime?
  messageCount           Int       @default(0)
  summaryText            String?   @db.Text
  summaryThroughSequence BigInt    @default(0)
  summaryVersion         Int       @default(0)
  summaryUpdatedAt       DateTime?

  owner        User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  course       Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages     CourseConversationMessage[]
  questionRuns CourseQuestionRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, courseId, sessionId], map: "CourseConversation_owner_course_session_key")
  @@unique([id, ownerId, courseId], map: "CourseConversation_id_owner_course_key")
  @@unique([id, ownerId, courseId, sessionId], map: "CourseConversation_id_owner_course_session_key")
  @@index([ownerId, courseId, deletedAt, updatedAt(sort: Desc), id(sort: Desc)], map: "CourseConversation_owner_course_deleted_updated_idx")
}

model CourseConversationMessage {
  id             String @id
  conversationId String
  ownerId        String
  courseId       String
  sequence       BigInt

  role               CourseConversationMessageRole?
  content            Json?
  plainText          String?                        @db.Text
  idempotencyKey     String?
  requestId          String?
  requestPayloadHash String?
  deletedAt          DateTime?

  conversation CourseConversation @relation(fields: [conversationId, ownerId, courseId], references: [id, ownerId, courseId], onDelete: Cascade, map: "CourseConversationMessage_parent_fkey")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, sequence], map: "CourseConversationMessage_conversation_sequence_key")
  @@index([conversationId, deletedAt, createdAt(sort: Desc), id(sort: Desc)], map: "CourseConversationMessage_conversation_deleted_created_idx")
  @@index([conversationId, deletedAt(sort: Desc), id(sort: Desc)], map: "CourseConversationMessage_conversation_tombstone_idx")
  @@index([ownerId, courseId, deletedAt, createdAt(sort: Desc), id(sort: Desc)], map: "CourseConversationMessage_owner_course_deleted_created_idx")
}

model AgentTask {
  id            String          @id @default(cuid())
  ownerId       String
  courseId      String?
  notebookId    String?
  sourceAgentId String?
  targetAgentId String?
  taskType      String
