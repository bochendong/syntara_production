/// One first-class record for an original source owned by a course.
/// Derived notebooks, problems, memories, and search documents point back to this
/// record instead of reconstructing source identity from sourceHash at read time.
model CourseSource {
  id                   String    @id @default(cuid())
  ownerId              String
  courseId             String
  sourceHash           String
  title                String
  kind                 String    @default("upload")
  fileMime             String?
  fileData             Bytes?
  fileSize             Int       @default(0)
  sourceCategory       String?
  removedAt            DateTime?
  usageProfile         String?
  topic                String?
  storageKey           String?
  openaiFileId         String?
  extractedText        String?   @db.Text
  extractedTextHash    String?
  ingestStatus         String    @default("pending")
  ingestLeaseToken     String?
  ingestLeaseExpiresAt DateTime?
  indexStatus          String    @default("pending")
  indexLeaseToken      String?
  indexLeaseExpiresAt  DateTime?
  errorReason          String?   @db.Text
  metadataJson         Json?
  artifactCountsJson   Json?
  contentVersion       Int       @default(1)
  ingestedAt           DateTime?
  indexedAt            DateTime?

  owner     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]
  chunks    KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([courseId, sourceHash], map: "CourseSource_course_hash_key")
  @@index([ownerId, courseId, updatedAt(sort: Desc)], map: "CourseSource_owner_course_updated_idx")
  @@index([ingestStatus, ingestLeaseExpiresAt], map: "CourseSource_ingest_status_lease_idx")
  @@index([courseId, ingestStatus, indexStatus, updatedAt(sort: Desc)], map: "CourseSource_course_status_updated_idx")
  @@index([courseId, kind, updatedAt(sort: Desc)], map: "CourseSource_course_kind_updated_idx")
  @@index([courseId, removedAt, updatedAt(sort: Desc)], map: "CourseSource_course_removed_updated_idx")
  @@index([storageKey], map: "CourseSource_storage_key_idx")
  @@index([openaiFileId], map: "CourseSource_openai_file_idx")
}

/// Rebuildable, course-scoped search projection over source sections, problems,
/// notebook summaries, and other knowledge-bearing business records.
model KnowledgeDocument {
  id               String    @id @default(cuid())
  ownerId          String
  courseId         String
  courseSourceId   String?
  notebookId       String?
  documentKey      String
  documentType     String
  sourceEntityType String
  sourceEntityId   String
  title            String
  summary          String?   @db.Text
  content          String    @db.Text
  contentHash      String
  language         String?
  visibility       String    @default("course")
  status           String    @default("pending")
  errorReason      String?   @db.Text
  metadataJson     Json?
  contentVersion   Int       @default(1)
  chunkCount       Int       @default(0)
  publishedAt      DateTime?
  indexedAt        DateTime?

  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseSource CourseSource?    @relation(fields: [courseSourceId], references: [id], onDelete: Cascade)
  notebook     Notebook?        @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([courseId, documentKey], map: "KnowledgeDocument_course_document_key")
  @@index([courseId, status, documentType, updatedAt(sort: Desc)], map: "KnowledgeDocument_course_status_type_idx")
  @@index([courseId, sourceEntityType, sourceEntityId], map: "KnowledgeDocument_course_entity_idx")
  @@index([courseSourceId, updatedAt(sort: Desc)], map: "KnowledgeDocument_source_updated_idx")
  @@index([notebookId, documentType, updatedAt(sort: Desc)], map: "KnowledgeDocument_notebook_type_idx")
  @@index([ownerId, courseId, updatedAt(sort: Desc)], map: "KnowledgeDocument_owner_course_idx")
}

/// Search-sized slices of a KnowledgeDocument. Course, visibility, document type,
/// and source are intentionally denormalized so filtered retrieval does not need
/// to widen ANN candidates before applying authorization boundaries.
model KnowledgeChunk {
  id                  String                 @id @default(cuid())
  documentId          String
  ownerId             String
  courseId            String
  courseSourceId      String?
  notebookId          String?
  documentType        String
  visibility          String                 @default("course")
  chunkIndex          Int
  chunkText           String                 @db.Text
  contentHash         String
  tokenCount          Int?
  metadataJson        Json?
  embeddingModel      String?
  embeddingDimensions Int?
  embedding           Unsupported("vector")?

  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseSource CourseSource?     @relation(fields: [courseSourceId], references: [id], onDelete: SetNull)
  notebook     Notebook?         @relation(fields: [notebookId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([documentId, chunkIndex], map: "KnowledgeChunk_document_chunk_key")
  @@index([courseId, documentId, chunkIndex], map: "KnowledgeChunk_course_document_idx")
  @@index([ownerId, courseId, visibility, documentType], map: "KnowledgeChunk_owner_course_filter_idx")
  @@index([courseId, notebookId, visibility, documentType], map: "KnowledgeChunk_course_notebook_filter_idx")
  @@index([courseSourceId, documentId], map: "KnowledgeChunk_source_document_idx")
}

